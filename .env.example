# =============================================================================
# RoleRadar Deployment & Environment Configuration Template
# Copy this file to .env and customize values for your deployment.
# =============================================================================

# Backend Database Configuration (PostgreSQL)
# Used by FastAPI backend and data loader.
# If unset, defaults to local PostgreSQL database 'jobber'.
# Example: postgresql://username:password@ep-sample.aws.neon.tech/jobber?sslmode=require
DATABASE_URL=

# Backend CORS Configuration
# Allowed origins for browser requests to FastAPI.
# Default allows: http://localhost:5173, http://127.0.0.1:5173
# Provide comma-separated URLs for your production frontend:
# Example: https://roleradar-app.vercel.app
FRONTEND_ORIGIN=

# Frontend Configuration (Vite)
# Base URL for the FastAPI backend.
# Development default: http://127.0.0.1:8000. Production default: same origin.
# Cross-origin production APIs must use HTTPS.
# Example: https://roleradar-api.onrender.com
VITE_API_BASE_URL=

{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "jobber-mauve.vercel.app"
        }
      ],
      "destination": "https://roleradar-jobs.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jobber-mauve.vercel.app"
        }
      ],
      "destination": "https://roleradar-jobs.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/company-background",
      "destination": "/api/company-background"
    },
    {
      "source": "/api/:path*",
      "destination": "https://roleradar-api.vercel.app/api/:path*"
    },
    {
      "source": "/jobs/:jobId+",
      "destination": "/api/job-page?jobId=:jobId+"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!google907a2d17d4884ed2\\.html$|sitemap\\.xml$|robots\\.txt$|assets/|logos/|favicon\\.svg$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' https://vercel.live https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/company-background.mjs": {
      "maxDuration": 10
    },
    "api/job-page.mjs": {
      "maxDuration": 10,
      "includeFiles": "dist/**"
    },
    "api/sitemap.mjs": {
      "maxDuration": 15
    }
  }
}
